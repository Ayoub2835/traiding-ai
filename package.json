{
  "name": "jarvis",
  "productName": "Jarvis",
  "version": "2.0.0",
  "description": "Jarvis v2: asistente personal de escritorio (voz, cerebro local/Claude, manos con Claude Code, habilidades, rutinas)",
  "main": "src/main.js",
  "author": "Ayoub",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "modelo": "node scripts/preparar-modelo.js",
    "start": "electron .",
    "compilar": "npm run modelo && electron-builder --win nsis --x64",
    "probar-n8n": "node scripts/probar-n8n.js",
    "test": "node --test --test-force-exit \"test/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "smol-toml": "^1.9.1",
    "vosk-browser": "^0.0.8"
  },
  "devDependencies": {
    "adm-zip": "^0.6.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "tar": "^7.5.22"
  },
  "build": {
    "appId": "com.ayoub.jarvis",
    "productName": "Jarvis",
    "copyright": "Ayoub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "config.ejemplo.json",
        "to": "config.ejemplo.json"
      },
      {
        "from": "modelo",
        "to": "modelo",
        "filter": [
          "modelo-es.tar.gz"
        ]
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "LICENSES",
        "to": "LICENSES"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "executableName": "Jarvis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Jarvis",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "uninstallDisplayName": "Jarvis",
      "artifactName": "Jarvis-Setup-${version}.exe"
    },
    "asarUnpack": [
      "src/manos/permisos-mcp.js"
    ]
  }
}
