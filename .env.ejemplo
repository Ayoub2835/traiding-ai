# Jarvis — plantilla de claves (VACÍA a propósito: este repositorio es público).
# Lo normal es pegarlas en la app: Ajustes → Claves y servicios (se guardan en %APPDATA%\Jarvis\.env).
# Para el modo gratis basta con GEMINI_API_KEY (y, si quieres correo, GMAIL_USUARIO + GMAIL_CLAVE_APP).

# --- Cerebro ---
# Clave de Gemini (gratis)
GEMINI_API_KEY=
# Modelo de Gemini
GEMINI_MODELO=
# Máximo de peticiones a Gemini al día
GEMINI_LIMITE_DIARIO=
# Clave de Claude (opcional, de pago)
ANTHROPIC_API_KEY=
# Modelo de Claude
CLAUDE_MODELO=
# Esfuerzo de Claude (low/medium/high)
CLAUDE_ESFUERZO=
# Dirección de Ollama
OLLAMA_URL=
# Modelo local de Ollama
OLLAMA_MODELO=

# --- Voz ---
# Modelo de Whisper local
WHISPER_MODELO=
# Voz en español (Edge, gratis)
EDGE_VOZ_ES=
# Voz en árabe (Edge)
EDGE_VOZ_AR=
# Voz para la dárija (Edge, árabe argelino)
EDGE_VOZ_DARIJA=
# Voz en francés (Edge)
EDGE_VOZ_FR=
# Clave de OpenAI (opcional, de pago)
OPENAI_API_KEY=
# Modelo OpenAI Realtime
OPENAI_REALTIME_MODELO=
# Voz de OpenAI
OPENAI_VOZ=
# Modelo Gemini Live
GEMINI_LIVE_MODELO=

# --- Correo ---
# Tu Gmail
GMAIL_USUARIO=
# Contraseña de aplicación de Gmail
GMAIL_CLAVE_APP=

# --- Avisos ---
# Tema de ntfy (tu canal privado)
NTFY_TEMA=
# Servidor ntfy
NTFY_SERVIDOR=
# Token de ntfy (opcional)
NTFY_TOKEN=
# Twilio Account SID
TWILIO_SID=
# Twilio Auth Token
TWILIO_TOKEN=
# Número Twilio (desde)
TWILIO_DESDE=
# Tu teléfono (a quién llamar)
TWILIO_A=

# --- Manos ---
# Tienda Shopify (xxx.myshopify.com)
SHOPIFY_TIENDA=
# Token Admin API de Shopify
SHOPIFY_TOKEN=
# URL MCP de n8n (opcional)
N8N_MCP_URL=
# Token MCP de n8n
N8N_MCP_TOKEN=
# Comando de Claude Code
CLAUDE_CODE_RUTA=

# --- Avanzado ---
# URL base de la API de Anthropic (solo pruebas)
ANTHROPIC_BASE_URL=
# URL base de la API de OpenAI (solo pruebas)
OPENAI_BASE_URL=
