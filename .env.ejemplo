# Jarvis v2 — plantilla de claves (VACÍA a propósito: este repositorio es público).
# Lo normal es pegarlas en la app: Ajustes → Claves y servicios (se guardan en %APPDATA%\Jarvis\.env).
# Si prefieres, copia este archivo como .env (no se sube a GitHub) y rellénalo.

# --- Cerebro ---
# Clave de Claude (Anthropic)
ANTHROPIC_API_KEY=
# Modelo de Claude
CLAUDE_MODELO=
# Esfuerzo de Claude (low/medium/high)
CLAUDE_ESFUERZO=
# Dirección de Ollama
OLLAMA_URL=
# Modelo local de Ollama
OLLAMA_MODELO=

# --- Voz ---
# Clave de OpenAI
OPENAI_API_KEY=
# Modelo OpenAI Realtime
OPENAI_REALTIME_MODELO=
# Voz de OpenAI
OPENAI_VOZ=
# Clave de Gemini (Google AI Studio)
GEMINI_API_KEY=
# Modelo Gemini Live
GEMINI_LIVE_MODELO=

# --- Avisos ---
# Tema de ntfy (tu canal privado)
NTFY_TEMA=
# Servidor ntfy
NTFY_SERVIDOR=
# Token de ntfy (opcional)
NTFY_TOKEN=
# Twilio Account SID
TWILIO_SID=
# Twilio Auth Token
TWILIO_TOKEN=
# Número Twilio (desde)
TWILIO_DESDE=
# Tu teléfono (a quién llamar)
TWILIO_A=

# --- Manos ---
# Tienda Shopify (xxx.myshopify.com)
SHOPIFY_TIENDA=
# Token Admin API de Shopify
SHOPIFY_TOKEN=
# URL MCP de n8n (opcional)
N8N_MCP_URL=
# Token MCP de n8n
N8N_MCP_TOKEN=
# Comando de Claude Code
CLAUDE_CODE_RUTA=

# --- Avanzado ---
# URL base de la API de Anthropic (solo pruebas)
ANTHROPIC_BASE_URL=
# URL base de la API de OpenAI (solo pruebas)
OPENAI_BASE_URL=
